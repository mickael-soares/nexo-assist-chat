# Nexo Assist - Variáveis de Ambiente
# Copie este arquivo para .env.local para customizar configurações

# Porta da aplicação
PORT=3000

# Provedor de LLM (Opcional - a aplicação possui motor determinístico completo para testes imediatos sem custo)
# Suporta OpenAI, Anthropic ou Google Gemini via Mastra / AI SDK
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Simulação de Indisponibilidade Intermitente do Sistema Legado de Chamados (true/false)
SIMULATE_LEGACY_FLAKINESS=false
